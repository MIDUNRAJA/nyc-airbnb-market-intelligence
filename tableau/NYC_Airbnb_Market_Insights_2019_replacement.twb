  <worksheets>
    <!-- Sheet 1: KPI Cards -->
    <worksheet name='KPI_Summary'>
      <table>
        <view>
          <datasources>
            <datasource caption='NYC_Airbnb_Tableau_Data' name='federated.nyc_airbnb_ds' />
          </datasources>
          <datasource-dependencies datasource='federated.nyc_airbnb_ds'>
            <column datatype='integer' name='[id]' role='dimension' type='ordinal' />
            <column datatype='integer' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[price_capped]' role='measure' type='quantitative' />
            <column-instance column='[id]' derivation='Count' name='[cnt:id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[price_capped]' derivation='Avg' name='[avg:price_capped:qk]' pivot='key' type='quantitative' />
            <column-instance column='[price_capped]' derivation='Median' name='[med:price_capped:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.nyc_airbnb_ds].[avg:price_capped:qk]</rows>
        <cols>[federated.nyc_airbnb_ds].[cnt:id:qk]</cols>
      </table>
      <simple-id uuid='{40871E94-AEDD-443D-8D7D-C89F26A04188}' />
    </worksheet>

